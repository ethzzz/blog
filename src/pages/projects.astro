---
import { getCollection } from "astro:content";
import RoadmapModuleCard from "@components/RoadmapModuleCard.astro";
import { PROJECT_GROUP } from "@constants/roadmap-modules";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";

const projectArticleSlugs = [
	"nextjs-roadmap-15-saas-project",
	"react-roadmap-17-project-task-board",
	"vue-roadmap-17-project-admin",
	"java-roadmap-20-graduation-workorder",
	"node-roadmap-13-project-task-api",
	"golang-roadmap-12-project-task-api",
	"python-roadmap-15-project-interview",
	"typescript-roadmap-17-project-type-safe-sdk",
	"js-roadmap-12-project-mini-libs",
	"higress-roadmap-15-project-gateway-launch",
	"browser-roadmap-12-project-perf-budget",
	"engineering-roadmap-15-project-delivery-gates",
];

const posts = await getCollection("posts", ({ data }) => !import.meta.env.PROD || !data.draft);
const postsBySlug = new Map(posts.map((post) => [post.slug, post]));
const projectArticles = projectArticleSlugs.flatMap((slug) => {
	const post = postsBySlug.get(slug);
	return post ? [post] : [];
});
const projectSeries = PROJECT_GROUP.modules.map((module) => {
	const { category, slugPrefix } = module;
	const count = posts.filter((post) =>
		post.data.category === category && (!slugPrefix || post.slug.startsWith(slugPrefix)),
	).length;
	return { module, count };
});
---

<MainGridLayout title={PROJECT_GROUP.name}>
	<div class="onload-animation">
		<header class="mb-8">
			<h1 class="text-3xl font-bold text-90 mb-2">{PROJECT_GROUP.name}</h1>
			<p class="text-75 text-lg">按系列跟做完整应用，或挑一篇实战完成独立交付。</p>
		</header>

		<section aria-labelledby="project-series" class="mb-8">
			<h2 id="project-series" class="text-lg font-bold text-90 mb-3">项目系列</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{projectSeries.map(({ module, count }) => <RoadmapModuleCard module={module} count={count} />)}
			</div>
		</section>

		<section aria-labelledby="project-articles">
			<h2 id="project-articles" class="text-lg font-bold text-90 mb-3">单篇实战</h2>
			<ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{projectArticles.map((post) => (
					<li>
						<a href={getPostUrlBySlug(post.slug)} class="block h-full card-base card-shadow p-5 hover:shadow-lg transition-all group">
							<p class="text-xs text-50 mb-1">{post.data.category}</p>
							<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] mb-1">
								{post.data.title}
							</h3>
							<p class="text-sm text-75">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	</div>
</MainGridLayout>
