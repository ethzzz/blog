---
import { getCollection } from "astro:content";
import { ROADMAP_GROUPS } from "@constants/roadmap-modules";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";

// 汇总所有文章，按 category 统计各模块篇数（PROD 下排除草稿）
const allPosts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const countByCategory = new Map<string, number>();
for (const post of allPosts) {
	const category = post.data.category;
	if (!category) continue;
	countByCategory.set(category, (countByCategory.get(category) ?? 0) + 1);
}

const groupData = ROADMAP_GROUPS.map((group) => ({
	...group,
	modules: group.modules.map((m) => ({
		...m,
		count: countByCategory.get(m.category) ?? 0,
	})),
}));

const moduleCount = groupData.reduce((sum, g) => sum + g.modules.length, 0);
const articleCount = groupData.reduce(
	(sum, g) => sum + g.modules.reduce((s, m) => s + m.count, 0),
	0,
);
---

<MainGridLayout title="学习路线总览">
	<div class="onload-animation">
		<!-- 页面标题 -->
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-90 mb-2">学习路线总览</h1>
			<p class="text-75 text-lg">
				{moduleCount} 条系统路线 · {articleCount} 篇实战笔记，按阶段顺序刷完即可
			</p>
		</div>

		{groupData.map((group) => (
			<div class="mb-8">
				<h2 class="text-lg font-bold text-90 mb-3 flex items-center gap-2">
					<span class="inline-block w-1 h-4 rounded-md bg-[var(--primary)]"></span>
					{group.name}
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{group.modules.map((m) => (
						<a href={url(m.url)}
						   class="card-base card-shadow p-5 flex items-start gap-4 hover:shadow-lg transition-all group">
							<div class="flex-shrink-0 w-12 h-12 rounded-lg bg-[var(--btn-regular-bg)] flex items-center justify-center text-[var(--btn-content)] font-bold text-base group-hover:bg-[var(--primary)] group-hover:text-white dark:group-hover:text-black/70 transition-colors">
								{m.abbr}
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center justify-between gap-2 mb-1">
									<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] transition-colors truncate">
										{m.title}
									</h3>
									<span class="flex-shrink-0 text-xs text-50">
										{m.count} 篇
									</span>
								</div>
								<p class="text-75 text-sm mb-2 line-clamp-2">
									{m.desc}
								</p>
								<div class="flex flex-wrap gap-1.5 text-xs">
									{m.chips.map((chip) => (
										<span class="px-1.5 py-0.5 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
											{chip}
										</span>
									))}
								</div>
							</div>
							<div class="flex-shrink-0 self-center text-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M5 12h14M12 5l7 7-7 7"></path>
								</svg>
							</div>
						</a>
					))}
				</div>
			</div>
		))}

		<!-- 底部说明 -->
		<div class="mt-8 p-4 rounded-lg bg-[var(--btn-regular-bg)] text-75 text-sm">
			<p class="font-medium mb-1">💡 使用建议</p>
			<p>
				每条路线都按「总览 → 阶段」编号排序，从 00-overview 进入即可按序阅读；
				已经熟悉的部分可以直接当速查表。				面试冲刺优先刷「算法与手写题」+
				<a href={url("/interview-guide/")} class="link text-[var(--primary)]">面试宝典</a>；
				想看真实项目怎么落地，移步
				<a href={url("/notelab/")} class="link text-[var(--primary)]">NoteLab 实战</a>。
			</p>
		</div>
	</div>
</MainGridLayout>
