---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getPostUrlBySlug, url } from "../../utils/url-utils";

const solutions = await getCollection("solutions", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const posts = await getCollection("posts");
const titleBySlug = new Map(posts.map((p) => [p.slug, p.data.title]));
const urlBySlug = new Map(posts.map((p) => [p.slug, getPostUrlBySlug(p.slug)]));

type SolutionEntry = (typeof solutions)[number];

const groups = new Map<string, SolutionEntry[]>();
for (const s of solutions) {
	const key = s.data.relatedPost || "__standalone__";
	const list = groups.get(key) ?? [];
	list.push(s);
	groups.set(key, list);
}

const grouped = [...groups.entries()]
	.map(([postSlug, list]) => ({
		postSlug,
		postTitle: titleBySlug.get(postSlug) ?? postSlug,
		postUrl: urlBySlug.get(postSlug) ?? null,
		list: list.sort(
			(a, b) =>
				a.data.order - b.data.order ||
				a.data.title.localeCompare(b.data.title, "zh-Hans-CN"),
		),
	}))
	.sort((a, b) => a.postTitle.localeCompare(b.postTitle, "zh-Hans-CN"));

const total = solutions.length;

const difficultyStyle = {
	简单: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
	中等: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
	困难: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
};
---
<MainGridLayout title="练习题解答" description="学习路线里每道练习题的参考解答，按原文分组">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <div class="onload-animation">
                <div class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    练习题解答
                </div>
                <div class="text-black/60 dark:text-white/60 mb-5" data-pagefind-body>
                    学习路线里每道练习题的参考答案，共 {total} 题，按所属文章分组。
                    建议先自己动手做一遍，再回来看解答——卡住的时候翻答案，收获是最小的。
                </div>
                <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>
            </div>

            <div class="flex flex-col gap-6 onload-animation">
                {grouped.map((g) => (
                    <div class="card-base !bg-transparent p-4">
                        <div class="flex flex-row items-center gap-2 mb-3">
                            <Icon name="material-symbols:menu-book-outline-rounded" class="text-[1.25rem] text-[var(--primary)]" />
                            {g.postUrl ? (
                                <a href={g.postUrl} class="font-bold text-lg transition hover:text-[var(--primary)] active:scale-95">
                                    {g.postTitle}
                                </a>
                            ) : (
                                <span class="font-bold text-lg">{g.postTitle}</span>
                            )}
                            <span class="text-sm text-black/40 dark:text-white/40">({g.list.length} 题)</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            {g.list.map((s) => (
                                <a href={url(`/solutions/${s.slug}/`)}
                                   class="flex flex-row items-center gap-3 px-3 py-2 rounded-lg transition hover:bg-[var(--btn-regular-bg)] active:scale-95">
                                    <span class="text-sm text-black/30 dark:text-white/30 w-6 shrink-0 text-right">{s.data.order || "-"}</span>
                                    <span class="flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">{s.data.title}</span>
                                    <span class:list={["text-xs px-2 py-0.5 rounded-md shrink-0", difficultyStyle[s.data.difficulty] ?? difficultyStyle["中等"]]}>
                                        {s.data.difficulty}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>
