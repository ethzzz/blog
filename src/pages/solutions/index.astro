---
// 解答清单：**运行时**从 Notelab 接口取（不再是 getCollection）。
//
// 为什么：解答在 Notelab 后台写、后台发布，博客只做呈现。走接口后「发布 → 刷新即见」，
// 不需要重建博客、也不需要等 CI（此前那条路要 push 博客仓 + GitHub Actions 构建，3–5 分钟）。
//
// ⚠️ 路线文章的标题仍取本地内容集合 posts —— posts 是静态写作内容，
// 没有接口化的必要；接口化的只有 solutions。
export const prerender = false;

import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import ViewCount from "@components/ViewCount.astro";
import { Icon } from "astro-icon/components";
import { fetchSolutions, type PublicSolution } from "../../utils/practice-api";
import { getPostUrlBySlug, url } from "../../utils/url-utils";

let solutions: PublicSolution[] = [];
let apiError = "";
try {
	solutions = await fetchSolutions();
} catch (e) {
	apiError = e instanceof Error ? e.message : String(e);
}

const posts = await getCollection("posts");
const titleBySlug = new Map(posts.map((p) => [p.slug, p.data.title]));
const urlBySlug = new Map(posts.map((p) => [p.slug, getPostUrlBySlug(p.slug)]));

const groups = new Map<string, PublicSolution[]>();
for (const s of solutions) {
	const key = s.relatedPost || "__standalone__";
	const list = groups.get(key) ?? [];
	list.push(s);
	groups.set(key, list);
}

const grouped = [...groups.entries()]
	.map(([postSlug, list]) => ({
		postSlug,
		postTitle: titleBySlug.get(postSlug) ?? postSlug,
		postUrl: urlBySlug.get(postSlug) ?? null,
		list: list.sort(
			(a, b) =>
				a.order - b.order || a.title.localeCompare(b.title, "zh-Hans-CN"),
		),
	}))
	.sort((a, b) => a.postTitle.localeCompare(b.postTitle, "zh-Hans-CN"));

const total = solutions.length;

// 显式声明成 Record：接口返回的 difficulty 是 string，不加索引签名 TS 会报 7053
const difficultyStyle: Record<string, string> = {
	简单: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
	中等: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
	困难: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
};
---
<MainGridLayout title="练习实践" description="学习路线里每道练习题的参考解答，按原文分组">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <div class="onload-animation">
                <div class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    练习实践
                </div>
                <div class="text-black/60 dark:text-white/60 mb-5" data-pagefind-body>
                    学习路线里每道练习题的参考答案，共 {total} 题，按所属文章分组。
                    建议先自己动手做一遍，再回来看解答——卡住的时候翻答案，收获是最小的。
                </div>
                <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>
            </div>

            {apiError && (
                <div class="mb-4 px-4 py-3 rounded-lg bg-[var(--btn-regular-bg)] text-sm text-black/60 dark:text-white/60">
                    解答列表暂时拉不到：{apiError}
                </div>
            )}

            {total === 0 && !apiError && (
                <div class="py-10 text-center text-sm text-black/40 dark:text-white/40">还没有已发布的解答</div>
            )}

            <div class="flex flex-col gap-6 onload-animation">
                {grouped.map((g) => (
                    <div class="card-base !bg-transparent p-4">
                        <div class="flex flex-row items-center gap-2 mb-3">
                            <Icon name="material-symbols:menu-book-outline-rounded" class="text-[1.25rem] text-[var(--primary)]" />
                            {g.postUrl ? (
                                <a href={g.postUrl} class="font-bold text-lg transition hover:text-[var(--primary)] active:scale-95">
                                    {g.postTitle}
                                </a>
                            ) : (
                                <span class="font-bold text-lg">{g.postTitle}</span>
                            )}
                            <span class="text-sm text-black/40 dark:text-white/40">({g.list.length} 题)</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            {g.list.map((s) => (
                                <a href={url(`/solutions/${s.slug}/`)}
                                   class="flex flex-row items-center gap-3 px-3 py-2 rounded-lg transition hover:bg-[var(--btn-regular-bg)] active:scale-95">
                                    <span class="text-sm text-black/30 dark:text-white/30 w-6 shrink-0 text-right">{s.order || "-"}</span>
                                    <span class="flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">{s.title}</span>
                                    {/* 列表只展示、不上报（primary 只在详情页传），整页合并成一次批量请求 */}
                                    <ViewCount slug={s.slug} class="shrink-0" />
                                    <span class:list={["text-xs px-2 py-0.5 rounded-md shrink-0", difficultyStyle[s.difficulty] ?? difficultyStyle["中等"]]}>
                                        {s.difficulty}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>
