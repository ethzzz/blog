---
// 单篇解答：**运行时**从 Notelab 接口取正文，再用与构建期同一套 markdown 管线渲染
// （代码高亮 / 提示块 / 标题锚点都由 src/utils/runtime-markdown.ts 复刻，见那里为什么这么做）。
//
// 没有 getStaticPaths：这个路由是 prerender=false，任意 slug 都由请求时现取。
export const prerender = false;

import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../config";
import { fetchSolution } from "../../utils/practice-api";
import {
	expressiveCodeAssets,
	renderMarkdown,
} from "../../utils/runtime-markdown";
import { getPostUrlBySlug, url } from "../../utils/url-utils";

const slug = Astro.params.slug ?? "";

let entry = null;
let apiError = "";
try {
	entry = await fetchSolution(slug);
} catch (e) {
	apiError = e instanceof Error ? e.message : String(e);
}
if (!entry && !apiError) Astro.response.status = 404; // 真·未发布/不存在 → 404（别让搜索引擎收录）
if (apiError) Astro.response.status = 502;

const rendered = entry ? await renderMarkdown(entry.content ?? "") : null;
const ec = await expressiveCodeAssets();

const prev = entry?.prev ?? null;
const next = entry?.next ?? null;
const relatedUrl = entry?.relatedPost
	? getPostUrlBySlug(entry.relatedPost)
	: null;

const difficultyStyle =
	{
		简单: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
		中等: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
		困难: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]",
	}[entry?.difficulty ?? ""] ??
	"bg-[var(--btn-regular-bg)] text-[var(--btn-content)]";

const jsonLd = entry
	? {
			"@context": "https://schema.org",
			"@type": "TechArticle",
			headline: entry.title,
			description: entry.description || entry.title,
			keywords: entry.tags,
			author: {
				"@type": "Person",
				name: profileConfig.name,
				url: Astro.site,
			},
			datePublished: entry.published,
			inLanguage: siteConfig.lang.replace("_", "-"),
		}
	: null;
---
<MainGridLayout
    title={entry ? entry.title : apiError ? "解答暂时无法加载" : "没有这篇解答"}
    description={entry ? entry.description : "这篇解答不存在或还没有发布"}
    setOGTypeArticle={!!entry}
    headings={rendered?.headings ?? []}
>
    {/* expressive-code 的样式/脚本：构建期由集成自动注入每个页面，运行时渲染的页面得自己带 */}
    <style is:inline slot="head" set:html={ec.styles}></style>
    {ec.scripts.map((code) => <script is:inline slot="head" set:html={code}></script>)}
    {jsonLd && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}

    {!entry ? (
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
            <div class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full text-center">
                <div class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    {apiError ? "解答暂时无法加载" : "没有这篇解答"}
                </div>
                <div class="text-black/60 dark:text-white/60 mb-6">
                    {apiError
                        ? `解答服务没有响应（${apiError}），请稍后再试。`
                        : "它可能还没有发布，或者地址拼错了。"}
                </div>
                <a href={url("/solutions/")} class="btn-regular rounded-lg px-4 py-2 font-bold active:scale-95">
                    回到练习实践
                </a>
            </div>
        </div>
    ) : (
    <>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">

            <!-- 返回原题 -->
            {relatedUrl && (
                <a href={relatedUrl}
                   class="inline-flex flex-row items-center gap-2 mb-4 text-sm font-bold text-[var(--primary)] transition active:scale-95">
                    <Icon name="material-symbols:chevron-left-rounded" class="text-[1.25rem]" />
                    返回原题与练习清单
                </a>
            )}

            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{rendered!.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {rendered!.minutes} {" " + i18n(rendered!.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <span class:list={["text-xs px-2 py-0.5 rounded-md font-bold", difficultyStyle]}>
                        {entry.difficulty}
                    </span>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.title}
                </div>
                {entry.tags.length > 0 && (
                    <div class="flex flex-row flex-wrap gap-2 mb-2">
                        {entry.tags.map((t: string) => (
                            <span class="text-xs px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">{t}</span>
                        ))}
                    </div>
                )}
            </div>

            <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>

            <Markdown class="mb-6 markdown-content onload-animation">
                <Fragment set:html={rendered!.html} />
            </Markdown>

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={prev ? url(`/solutions/${prev.slug}/`) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !prev}]}>
            {prev && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4">
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {prev.title}
                </div>
            </div>}
        </a>

        <a href={next ? url(`/solutions/${next.slug}/`) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !next}]}>
            {next && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {next.title}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>
    </>
    )}

</MainGridLayout>
