---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";

// 获取所有前端工程化学习路线文章
const allPosts = await getCollection("posts", ({ data }) => {
	return (
		data.category === "前端工程化学习路线" &&
		(import.meta.env.PROD ? data.draft !== true : true)
	);
});

// 按 slug 中的阶段编号排序
const sortedPosts = allPosts.sort((a, b) => {
	const numA = Number.parseInt(
		a.slug.match(/engineering-roadmap-(\d+)/)?.[1] ?? "0",
		10,
	);
	const numB = Number.parseInt(
		b.slug.match(/engineering-roadmap-(\d+)/)?.[1] ?? "0",
		10,
	);
	return numA - numB;
});

// 分离总览和阶段文章
const overviewPost = sortedPosts.find((p) => p.slug.includes("00-overview"));
const stagePosts = sortedPosts.filter((p) => !p.slug.includes("00-overview"));
---

<MainGridLayout title="前端工程化">
	<div class="onload-animation">
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-90 mb-2">前端工程化</h1>
			<p class="text-75 text-lg">从写代码到稳定交付：构建、规范、CI/CD 与 Monorepo · 共 {sortedPosts.length} 篇</p>
		</div>

		<div class="card-base card-shadow p-5 mb-6 bg-gradient-to-r from-[var(--btn-regular-bg)] to-transparent">
			<div class="flex items-start gap-4">
				<div class="flex-shrink-0 w-12 h-12 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white font-bold text-xl">
					FE
				</div>
				<div class="flex-1">
					<h2 class="text-lg font-bold text-90 mb-1">前端工程化 - 从代码到交付</h2>
					<p class="text-75 text-sm mb-2">包管理、模块打包、代码规范、质量门禁、持续集成，把"能跑"变成"可维护、可协作、可发布"</p>
					<div class="flex flex-wrap gap-2 text-xs">
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Vite</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Webpack</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">pnpm</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">ESLint</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">CI/CD</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Monorepo</span>
					</div>
				</div>
				<a href="https://vitejs.dev/" target="_blank" rel="noopener"
				   class="flex-shrink-0 text-[var(--primary)] hover:opacity-75 transition-opacity">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
				</a>
			</div>
		</div>

		{overviewPost && (
			<a href={getPostUrlBySlug(overviewPost.slug)}
			   class="block card-base card-shadow p-6 mb-6 hover:shadow-lg transition-all group">
				<div class="flex items-start justify-between">
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-2">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--primary)] text-white">总览</span>
							<span class="text-sm text-50">{overviewPost.data.published.toLocaleDateString("zh-CN")}</span>
						</div>
						<h2 class="text-xl font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">{overviewPost.data.title}</h2>
						<p class="text-75 text-sm line-clamp-2">{overviewPost.data.description}</p>
					</div>
					<div class="ml-4 text-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</div>
				</div>
			</a>
		)}

		<div class="space-y-4">
			{stagePosts.map((post, index) => (
				<a href={getPostUrlBySlug(post.slug)}
				   class="block card-base card-shadow p-5 hover:shadow-lg transition-all group">
					<div class="flex items-start gap-4">
						<div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--btn-regular-bg)] flex items-center justify-center text-[var(--btn-content)] font-bold text-lg group-hover:bg-[var(--primary)] group-hover:text-white transition-colors">{index + 1}</div>
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2 mb-1">
								<h3 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors truncate">{post.data.title}</h3>
							</div>
							<p class="text-75 text-sm mb-2 line-clamp-2">{post.data.description}</p>
							<div class="flex items-center gap-3 text-xs text-50">
								<span>{post.data.published.toLocaleDateString("zh-CN")}</span>
								{post.data.tags && post.data.tags.length > 0 && (
									<span class="flex items-center gap-1">
										{post.data.tags.slice(0, 3).map(tag => (<span class="px-1.5 py-0.5 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">#{tag}</span>))}
									</span>
								)}
							</div>
						</div>
						<div class="flex-shrink-0 text-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity self-center">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</div>
					</div>
				</a>
			))}
		</div>

		<div class="mt-8 p-4 rounded-lg bg-[var(--btn-regular-bg)] text-75 text-sm">
			<p class="font-medium mb-1">💡 学习建议</p>
			<p>工程化不是堆工具，而是解决"协作规模上升后的失控"。先理解打包器到底在做什么（依赖图、转译、拆分），再学配置；规范与 CI 要"fail fast"，把问题挡在本地。Monorepo 别盲目上，先想清楚收益。</p>
		</div>

		<div class="mt-4 flex flex-wrap gap-4 text-sm">
			<a href="https://vitejs.dev/" target="_blank" rel="noopener" class="link text-[var(--primary)] flex items-center gap-1">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
				Vite 文档
			</a>
			<a href="https://webpack.js.org/" target="_blank" rel="noopener" class="link text-[var(--primary)] flex items-center gap-1">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
				Webpack 文档
			</a>
		</div>
	</div>
</MainGridLayout>
