---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { AI_APP_CATEGORY, aiAppRoadmapOrder } from "@utils/ai-app-roadmap";
import { getPostUrlBySlug } from "@utils/url-utils";

const posts = await getCollection("posts", ({ data }) =>
	data.category === AI_APP_CATEGORY && (!import.meta.env.PROD || !data.draft),
);

const sortedPosts = posts.sort((a, b) => aiAppRoadmapOrder(a.slug) - aiAppRoadmapOrder(b.slug));
const overview = sortedPosts.find((post) => aiAppRoadmapOrder(post.slug) === 0);
const stages = sortedPosts.filter((post) => post.slug.startsWith("ai-app-workshop-"));
const graduation = sortedPosts.find((post) => post.slug === "ai-app-roadmap-13-project-ai-app");
const topics = sortedPosts.filter((post) => aiAppRoadmapOrder(post.slug) >= 100);
---

<MainGridLayout title="AI 应用开发实战">
	<div class="onload-animation">
		<header class="mb-6">
			<h1 class="text-3xl font-bold text-90 mb-2">AI 应用开发实战</h1>
			<p class="text-75 text-lg">跟着文档从第一条流式对话开始，做完一个团队知识库助手。</p>
		</header>

		{overview && (
			<a href={getPostUrlBySlug(overview.slug)} class="block card-base card-shadow p-5 mb-6 group">
				<h2 class="text-xl font-bold text-90 group-hover:text-[var(--primary)] mb-2">
					项目总览
				</h2>
				<p class="text-75 text-sm">{overview.data.description}</p>
			</a>
		)}

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			<section aria-labelledby="workshop-heading">
				<h2 id="workshop-heading" class="text-lg font-bold text-90 mb-3">按顺序做项目</h2>
				<ol class="space-y-3">
					{[...stages, ...(graduation ? [graduation] : [])].map((post) => (
						<li>
							<a href={getPostUrlBySlug(post.slug)} class="block card-base card-shadow p-4 group">
								<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] mb-1">
									{post.data.title}
								</h3>
								<p class="text-75 text-sm">{post.data.description}</p>
							</a>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="topics-heading">
				<h2 id="topics-heading" class="text-lg font-bold text-90 mb-3">专题参考</h2>
				<ul class="card-base card-shadow px-4 py-2 divide-y divide-[var(--line-divider)]">
					{topics.map((post) => (
						<li>
							<a href={getPostUrlBySlug(post.slug)} class="block py-3 text-sm font-medium text-90 hover:text-[var(--primary)]">
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>
	</div>
</MainGridLayout>
