---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";

// 获取所有 AI 应用开发学习路线文章
const allPosts = await getCollection("posts", ({ data }) => {
	return (
		data.category === "AI应用开发学习路线" &&
		(import.meta.env.PROD ? data.draft !== true : true)
	);
});

// 按 slug 中的阶段编号排序
const sortedPosts = allPosts.sort((a, b) => {
	const numA = Number.parseInt(
		a.slug.match(/ai-app-roadmap-(\d+)/)?.[1] ?? "0",
		10,
	);
	const numB = Number.parseInt(
		b.slug.match(/ai-app-roadmap-(\d+)/)?.[1] ?? "0",
		10,
	);
	return numA - numB;
});

// 分离总览和阶段文章
const overviewPost = sortedPosts.find((p) => p.slug.includes("00-overview"));
const stagePosts = sortedPosts.filter((p) => !p.slug.includes("00-overview"));
---

<MainGridLayout title="AI 应用开发路线合集">
	<div class="onload-animation">
		<!-- 页面标题 -->
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-90 mb-2">AI 应用开发路线（面向前端工程师）</h1>
			<p class="text-75 text-lg">用前端工程能力把大模型做成真实产品 · 系统学习路径 · 共 {sortedPosts.length} 篇</p>
		</div>

		<!-- 项目信息卡片 -->
		<div class="card-base card-shadow p-5 mb-6 bg-gradient-to-r from-[var(--btn-regular-bg)] to-transparent">
			<div class="flex items-start gap-4">
				<div class="flex-shrink-0 w-12 h-12 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white font-bold text-xl">
					AI
				</div>
				<div class="flex-1">
					<h2 class="text-lg font-bold text-90 mb-1">AI 应用开发 - 前端工程师的 LLM 落地笔记</h2>
					<p class="text-75 text-sm mb-2">用前端工程能力把大模型做成真实产品：从 API 封装、流式输出、Prompt 工程到 RAG、Agent 与网关基建，全程一手踩坑经验</p>
					<div class="flex flex-wrap gap-2 text-xs">
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">LLM</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Prompt</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">SSE 流式</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">RAG</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Agent</span>
						<span class="px-2 py-1 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">Qwen</span>
					</div>
				</div>
				<a href="https://platform.openai.com/docs" target="_blank" rel="noopener"
				   class="flex-shrink-0 text-[var(--primary)] hover:opacity-75 transition-opacity">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
						<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
					</svg>
				</a>
			</div>
		</div>

		<!-- 总览卡片 -->
		{overviewPost && (
			<a href={getPostUrlBySlug(overviewPost.slug)}
			   class="block card-base card-shadow p-6 mb-6 hover:shadow-lg transition-all group">
				<div class="flex items-start justify-between">
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-2">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--primary)] text-white">
								总览
							</span>
							<span class="text-sm text-50">
								{overviewPost.data.published.toLocaleDateString("zh-CN")}
							</span>
						</div>
						<h2 class="text-xl font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
							{overviewPost.data.title}
						</h2>
						<p class="text-75 text-sm line-clamp-2">
							{overviewPost.data.description}
						</p>
					</div>
					<div class="ml-4 text-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</div>
				</div>
			</a>
		)}

		<!-- 阶段文章列表 -->
		<div class="space-y-4">
			{stagePosts.map((post, index) => (
				<a href={getPostUrlBySlug(post.slug)}
				   class="block card-base card-shadow p-5 hover:shadow-lg transition-all group">
					<div class="flex items-start gap-4">
						<!-- 阶段编号 -->
						<div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--btn-regular-bg)] flex items-center justify-center text-[var(--btn-content)] font-bold text-lg group-hover:bg-[var(--primary)] group-hover:text-white transition-colors">
							{index + 1}
						</div>

						<!-- 文章内容 -->
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2 mb-1">
								<h3 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors truncate">
									{post.data.title}
								</h3>
							</div>
							<p class="text-75 text-sm mb-2 line-clamp-2">
								{post.data.description}
							</p>
							<div class="flex items-center gap-3 text-xs text-50">
								<span>{post.data.published.toLocaleDateString("zh-CN")}</span>
								{post.data.tags && post.data.tags.length > 0 && (
									<span class="flex items-center gap-1">
										{post.data.tags.slice(0, 3).map(tag => (
											<span class="px-1.5 py-0.5 rounded bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
												#{tag}
											</span>
										))}
									</span>
								)}
							</div>
						</div>

						<!-- 箭头 -->
						<div class="flex-shrink-0 text-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity self-center">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</div>
					</div>
				</a>
			))}
		</div>

		<!-- 底部说明 -->
		<div class="mt-8 p-4 rounded-lg bg-[var(--btn-regular-bg)] text-75 text-sm">
			<p class="font-medium mb-1">💡 学习建议</p>
			<p>按阶段顺序阅读：01-05 是基本功（API 封装 / Prompt / 流式 / 结构化输出），务必每篇动手跑通；06-08 是进阶能力（RAG / Agent / 多模态），建议配一个真实小项目练手；09-12 是产品化与工程化（落地场景 / 评估 / 网关 / 安全合规），适合在工作中边做边对照。每篇末尾有练习，敲完代码再往下走。</p>
		</div>

		<!-- 项目链接 -->
		<div class="mt-4 flex flex-wrap gap-4 text-sm">
			<a href="https://platform.openai.com/docs" target="_blank" rel="noopener"
			   class="link text-[var(--primary)] flex items-center gap-1">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
					<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
				</svg>
				OpenAI Platform 文档
			</a>
			<a href="https://help.aliyun.com/zh/model-studio/" target="_blank" rel="noopener"
			   class="link text-[var(--primary)] flex items-center gap-1">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
					<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
				</svg>
				阿里云百炼（DashScope）文档
			</a>
			<a href="https://help.qwen.ai/zh/" target="_blank" rel="noopener"
			   class="link text-[var(--primary)] flex items-center gap-1">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
					<polyline points="14 2 14 8 20 8"/>
					<line x1="16" y1="13" x2="8" y2="13"/>
					<line x1="16" y1="17" x2="8" y2="17"/>
					<polyline points="10 9 9 9 8 9"/>
				</svg>
				Qwen 模型文档
			</a>
		</div>
	</div>
</MainGridLayout>
