---
// 草稿预览（`/blog/preview/<token>/`）：正文**运行时**从 Notelab 取（还没写进仓库的草稿），
// 用与线上文章页**同一套布局 + 同一套 markdown 管线**渲染。
//
// 为什么要有这个路由：后台用 marked 渲染永远与线上不一致 —— 代码高亮 / 提示块 / KaTeX / 标题锚点
// 全是**构建期管线**的事（复刻那套管线的就是 src/utils/runtime-markdown.ts，练习解答页也在用它）。
// 用户 2026-10-16 明确要求「预览界面要和线上博客文章页一致」，那就只能让博客自己渲染。
//
// ⚠️ 预览的是**未发布内容**：授权手段只有「不可猜的 token」（java 侧 128 位随机 + 30 分钟 TTL），
//    所以这一页必须 noindex —— 它可能是一篇永远不发的草稿。
//
// ⚠️ 与线上文章页**刻意不同**的四处（都不影响正文观感，见任务简报 P3）：
//    ① 卡片上方多一个「预览」徽标（免得把草稿误当成已发布）；
//    ② 没有上下篇导航（草稿还没有前后关系）；
//    ③ 不显示浏览数（预览不是一次阅读，草稿 slug 也可能还没定）；
//    ④ 没有封面图（编辑器目前没有封面字段，接口也就不返回 image）。
export const prerender = false;

import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import PostMetadata from "../../components/PostMeta.astro";
import { fetchPreview } from "../../utils/notelab-preview-api";
import {
	expressiveCodeAssets,
	renderMarkdown,
} from "../../utils/runtime-markdown";

const token = Astro.params.token ?? "";

/**
 * embed=1：**只输出文章内容区**（给后台「文章起草」右侧的实时预览用）。
 *
 * 做法刻意是「保留整套布局与全局样式，只用 CSS 把导航/侧栏/目录/页脚藏掉」，
 * 而不是换一个精简 layout —— 正文排版依赖 Fuwari 的全局 CSS 变量与 Tailwind 产物，
 * 自建一个轻外壳就得复刻那一切，等于又造一套「和线上不一致」的预览，正好违背这个路由的初衷。
 */
const embed = Astro.url.searchParams.get("embed") === "1";

let entry = null;
let apiError = "";
try {
	entry = await fetchPreview(token);
} catch (e) {
	apiError = e instanceof Error ? e.message : String(e);
}
if (!entry && !apiError) Astro.response.status = 404; // 过期/不存在 → 404，别让爬虫收录一个空页
if (apiError) Astro.response.status = 502;

const rendered = entry ? await renderMarkdown(entry.body ?? "") : null;
const ec = await expressiveCodeAssets();

/** 草稿的发布时间可能还没填 —— 用当前时间占位（元信息行总要显示一个日期，与线上同样的位置） */
function safeDate(v?: string): Date {
	const d = v ? new Date(v) : new Date(Number.NaN);
	return Number.isNaN(d.getTime()) ? new Date() : d;
}
const publishedDate = entry ? safeDate(entry.published) : new Date();

/**
 * embed 模式的那一小段覆盖样式。
 *
 * 选择器一律用 MainGridLayout 里的稳定 **id**（`#main-panel` / `#main-grid` / `#swup-container`），
 * 别按 class 猜 —— Tailwind 的 class 会随样式调整漂移，而 id 是布局契约。
 *   · `#main-panel` 的 `top` 是硬编码的 5.5rem（给人间导航留的高度），藏掉导航后必须归零；
 *   · `#main-grid > :not(#swup-container)` 一次性排掉「左侧栏 + 两个页脚」，
 *     不用逐个点名（SideBar 渲染成什么标签、页脚有几份，都不必关心）；
 *   · `onload-animation` 是进场淡入，局部替换 innerHTML 时会重新播一遍 → 关掉，否则每次更新都闪。
 */
const EMBED_CSS = `
#top-row, #banner-wrapper, #toc-wrapper, #toc, .footer { display: none !important }
#main-panel { top: 0 !important }
#main-grid { grid-template-columns: 1fr !important; gap: 0 !important; padding: 0 !important }
#main-grid > :not(#swup-container) { display: none !important }
#swup-container { grid-column: 1 / -1 !important }
#content-wrapper { padding: 0 !important }
#post-card { margin: 0 !important; border-radius: 0 !important }
#post-container { border-radius: 0 !important; padding: 1rem 1.25rem !important }
.onload-animation { animation: none !important; opacity: 1 !important }
`;
---

<MainGridLayout
    title={entry ? `预览：${entry.title}` : apiError ? "预览暂时无法加载" : "预览已过期"}
    description={entry?.description || "未发布草稿的预览"}
    headings={rendered?.headings ?? []}
>
    <meta slot="head" name="robots" content="noindex,nofollow" />
    {/* expressive-code 的样式/脚本：构建期由集成注入每个页面，运行时渲染的页面得自己带 */}
    <style is:inline slot="head" set:html={ec.styles}></style>
    {ec.scripts.map((code) => <script is:inline slot="head" set:html={code}></script>)}
    {embed && <style is:inline slot="head" set:html={EMBED_CSS}></style>}

    {/* 预览徽标 —— 唯一与线上不同的可见元素，且刻意放在文章卡片**之外**。
        embed（后台右侧实时预览）时不渲染：那里只有正文的宽度，多一行提示只会挤掉内容 */}
    {!embed && (
        <div class="flex items-center gap-2 mb-3 px-1 text-sm">
            <Icon name="material-symbols:visibility-outline-rounded" class="text-[1.25rem] text-[var(--primary)]"></Icon>
            <span class="font-bold text-[var(--primary)]">预览</span>
            <span class="text-black/50 dark:text-white/50">未发布草稿 · 正文渲染与线上文章页一致</span>
        </div>
    )}

    {!entry ? (
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
            <div class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full text-center">
                <div class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    {apiError ? "预览暂时无法加载" : "预览已过期"}
                </div>
                <div class="text-black/60 dark:text-white/60 mb-6">
                    {apiError
                        ? `预览服务没有响应（${apiError}），请稍后再试。`
                        : "预览只保留 30 分钟。回后台重新点一次「预览」即可拿到新地址。"}
                </div>
            </div>
        </div>
    ) : (
    <div id="post-card" class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">

            {/* word count and reading time（与线上文章页同一行，含朗读按钮） */}
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div id="preview-words" class="text-sm">{rendered!.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div id="preview-minutes" class="text-sm">
                        {rendered!.minutes} {" " + i18n(rendered!.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
                <button id="tts-read-btn" type="button" aria-label="朗读全文" aria-busy="false"
                        class="flex flex-row items-center cursor-pointer transition active:scale-95 hover:text-[var(--primary)]">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:text-to-speech"></Icon>
                    </div>
                    <span id="tts-read-label" class="text-sm">阅读</span>
                </button>
            </div>

            {/* title */}
            <div class="relative onload-animation">
                <div
                    id="preview-title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.title}
                </div>
            </div>

            {/* metadata（与线上同组件、同排版；不传 slug，所以不出现浏览数） */}
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={publishedDate}
                        tags={entry.tags}
                        category={entry.category}
                        hideUpdateDate={true}
                ></PostMetadata>
                <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>
            </div>

            <Markdown id="preview-body" class="mb-6 markdown-content onload-animation">
                <Fragment set:html={rendered!.html} />
            </Markdown>

            {licenseConfig.enable && <License title={entry.title} slug={entry.slug} pubDate={publishedDate} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>
    )}

</MainGridLayout>

<script>
	// 与文章详情页同一个朗读脚本（预览页的正文 DOM 结构与它一致）
	import "../../scripts/tts-reader";
</script>

{/*
  embed 模式：接收后台发来的新正文，**只替换正文**，不刷新整页。
  刷新整页会白屏 + 丢滚动位置，而打字时每次停顿都会更新一次，那样根本没法用。

  ⚠️ 必须是 `is:inline`：普通 <script> 会被 Astro 打包并**提升**到模块里，
     外层 {embed && ...} 的条件包裹随之失效（等于所有访客都加载这段）。
*/}
<script is:inline define:vars={{ embed }}>
	if (embed) {
		window.addEventListener("message", function (e) {
			// 只认同源消息（后台与博客同域，iframe 里 location.origin 就是本站）
			if (e.origin !== window.location.origin) return;
			var d = e.data;
			if (!d || d.type !== "notelab-preview") return;
			var body = document.querySelector("#preview-body");
			if (body && typeof d.html === "string") body.innerHTML = d.html;
			function setText(sel, v) {
				if (typeof v !== "string") return;
				var el = document.querySelector(sel);
				if (el) el.textContent = v;
			}
			setText("#preview-title", d.title);
			setText("#preview-words", d.words);
			setText("#preview-minutes", d.minutes);
		});
	}
</script>
