---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import {
	INTERVIEW_CATEGORY,
	INTERVIEW_GROUPS,
	interviewNumOf,
} from "../constants/interview-groups";
import { LinkPresets } from "../constants/link-presets";
import {
	LinkPreset,
	type NavBarChildGroup,
	type NavBarLink,
} from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

// 「面试宝典」下拉子菜单：构建期从文章集合动态生成，与文章增删自动同步。
// 分组定义来自 @constants/interview-groups —— 与面试宝典页面**共用一份**。
// 原来这里另写了一套 5 组（页面是 7 组），同一篇文章在两处归属不同，见该文件头部注释。
const interviewPosts = (
	await getCollection("posts", ({ data }) => {
		return (
			data.category === INTERVIEW_CATEGORY &&
			(import.meta.env.PROD ? data.draft !== true : true)
		);
	})
).sort((a, b) => interviewNumOf(a.slug) - interviewNumOf(b.slug));

const interviewChildren: NavBarChildGroup[] = INTERVIEW_GROUPS.map((g) => ({
	title: g.name,
	items: interviewPosts
		.filter((p) => g.nums.includes(interviewNumOf(p.slug)))
		.map((p) => ({
			// 存不带 base 的原始路径：模板渲染时统一经 url() 拼前缀，
			// 与 config.ts 里其他 children 项的约定一致（getPostUrlBySlug 已含 base，不能混用）
			name: p.data.title,
			url: `/posts/${p.slug}/`,
		})),
})).filter((g) => g.items.length > 0);

// 分组数 > 3 的面板内容偏宽，限制最大宽度让其换行，避免贴边溢出视口
const panelMaxWidth = (children: NavBarChildGroup[]) =>
	children.length > 3
		? "max-w-[min(calc(100vw-2rem),32rem)]"
		: "max-w-[calc(100vw-2rem)]";

links = links.map((l) =>
	l.url === "/interview-guide/" ? { ...l, children: interviewChildren } : l,
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center gap-2 md:gap-4 px-4"]}>
        <!-- 站点标题：空间不足时省略号收尾，绝不换行（换行会把导航挤成一列） -->
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-4 md:px-5 font-bold active:scale-95
            shrink-0 min-w-0 max-w-[45vw] md:max-w-[32%] xl:max-w-[22rem] 2xl:max-w-none">
            <div class="flex flex-row text-[var(--primary)] items-center text-md min-w-0">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2 shrink-0" />
                <span class="truncate">{siteConfig.title}</span>
            </div>
        </a>
        <!-- 导航链接：白空格不换行，放不下时横向滚动（之前会整列堆叠）。
             外层相对定位承载两端渐隐提示，内层 scroller 支持鼠标拖拽/滚轮横滚。 -->
        <div class="nav-links-wrap hidden md:flex flex-1 min-w-0 items-center relative">
            <div id="nav-links-scroll" class="flex-1 min-w-0 flex items-center overflow-x-auto hide-scrollbar select-none">
                {links.map((l) => {
                    const menu = l.children && l.children.length > 0 ? l.children : null;
                    if (menu) {
                        return <div class="nav-dropdown-wrap relative shrink-0">
                            <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                               class="btn-plain scale-animation whitespace-nowrap rounded-lg h-11 font-bold px-2.5 md:px-3.5 xl:px-5 active:scale-95"
                            >
                                <div class="flex items-center">
                                    {l.shortName ?? l.name}
                                    <Icon name="material-symbols:expand-more-rounded" class="nav-dropdown-chevron text-[1.1rem] transition-transform duration-150"></Icon>
                                    {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                                </div>
                            </a>
                            {/* 面板用 fixed + JS 定位：若放在滚动容器内部会被 overflow 裁剪。
                                显隐由 JS 挂 .dropdown-open 控制（悬停/键盘聚焦），见 initNavDropdowns。 */}
                            <div class="nav-dropdown-panel">
                                <div class:list={["card-base !rounded-xl shadow-xl border border-black/5 dark:border-white/10 p-4 w-max max-h-[min(70vh,42rem)] !overflow-y-auto", panelMaxWidth(menu)]}>
                                    <a href={url(l.url)}
                                       class="flex items-center gap-1 text-sm font-bold text-[var(--primary)] px-2 py-1 rounded-lg hover:bg-[var(--btn-plain-bg-hover)] transition">
                                        进入{l.name}
                                        <Icon name="material-symbols:arrow-forward-rounded" class="text-[0.875rem]"></Icon>
                                    </a>
                                    <div class="flex flex-wrap gap-x-8 gap-y-3 mt-2 pt-2 border-t border-black/5 dark:border-white/10">
                                        {menu.map((g) => (
                                            <div class="min-w-0">
                                                <div class="text-xs font-bold text-50 px-2 pb-1 whitespace-nowrap">{g.title}</div>
                                                {g.items.map((it) => (
                                                    <a href={it.external ? it.url : url(it.url)} target={it.external ? "_blank" : null}
                                                       class="block px-2 py-1.5 rounded-lg text-sm text-75 whitespace-nowrap hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] transition">
                                                        {it.shortName ?? it.name}
                                                    </a>
                                                ))}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>;
                    }
                    return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                              class="btn-plain scale-animation shrink-0 whitespace-nowrap rounded-lg h-11 font-bold px-2.5 md:px-3.5 xl:px-5 active:scale-95"
                    >
                        <div class="flex items-center">
                            {l.shortName ?? l.name}
                            {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                        </div>
                    </a>;
                })}
            </div>
            <div id="nav-fade-left" class="nav-fade pointer-events-none absolute left-0 top-0 bottom-0 w-10 transition-opacity duration-200"
                 style={`background: linear-gradient(to right, var(--card-bg), transparent); opacity: 0;`}></div>
            <div id="nav-fade-right" class="nav-fade pointer-events-none absolute right-0 top-0 bottom-0 w-10 transition-opacity duration-200"
                 style={`background: linear-gradient(to left, var(--card-bg), transparent); opacity: 0;`}></div>
        </div>
        <div class="flex shrink-0">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<style>
	/* 链接区默认抓手光标，拖拽中变为握紧 */
	.nav-links-wrap #nav-links-scroll {
		cursor: grab;
	}
	.nav-links-wrap #nav-links-scroll.dragging {
		cursor: grabbing;
		user-select: none;
	}

	/* 下拉子菜单：absolute 挂在 sticky 的 #navbar-wrapper 下（JS 启动时搬运出滚动容器），
	   相对导航条自身定位——无论页面滚到哪、OverlayScrollbars 如何包裹，都严格贴在标题正下方。
	   显隐走 .dropdown-open（JS 挂），不依赖 :hover——面板 DOM 不在触发元素内。 */
	.nav-dropdown-panel {
		position: absolute;
		z-index: 50;
		visibility: hidden;
		opacity: 0;
		transform: translate(-50%, 6px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease,
			visibility 0.15s;
	}
	.nav-dropdown-panel.dropdown-open {
		visibility: visible;
		opacity: 1;
		transform: translate(-50%, 0);
	}
	.nav-dropdown-wrap.dropdown-open .nav-dropdown-chevron {
		transform: rotate(180deg);
	}
</style>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();

/* 导航链接区「左右滑动」增强：
   1) 鼠标按住拖拽即可横向滑动（触摸端走原生滑动，不劫持）；
   2) 悬停滚轮直接横滚（仅当内容真的溢出时才拦截）；
   3) 两端渐隐提示当前还有没有更多链接可滑。
   导航栏跨页共享（swup 只换主内容），所以监听器只注册一次。 */
function initNavLinksScroll() {
	const scroller = document.getElementById("nav-links-scroll");
	if (!scroller || scroller.dataset.scrollInit === "1") return;
	scroller.dataset.scrollInit = "1";

	const fadeLeft = document.getElementById("nav-fade-left");
	const fadeRight = document.getElementById("nav-fade-right");

	const updateFades = () => {
		const canLeft = scroller.scrollLeft > 2;
		const canRight =
			scroller.scrollLeft + scroller.clientWidth <
			scroller.scrollWidth - 2;
		if (fadeLeft) fadeLeft.style.opacity = canLeft ? "1" : "0";
		if (fadeRight) fadeRight.style.opacity = canRight ? "1" : "0";
	};
	updateFades();
	scroller.addEventListener("scroll", updateFades, { passive: true });
	window.addEventListener("resize", updateFades);
	// 字体加载完成后链接宽度会变，初始的溢出判断需要重算
	window.addEventListener("load", updateFades);
	if (document.fonts?.ready) {
		document.fonts.ready.then(updateFades);
	}
	// Search/LightDarkSwitch 是 client:only 组件，挂载晚于 fonts.ready，
	// 挂载后才会把 flex-1 的链接容器挤压出溢出——用 ResizeObserver 兜住任何尺寸变化
	if (typeof ResizeObserver !== "undefined") {
		new ResizeObserver(updateFades).observe(scroller);
	}

	// 鼠标拖拽滑动（pointerType=mouse 才接管，触摸/笔走原生滚动）。
	// 鼠标事件天然冒泡到 window，无需 setPointerCapture；
	// 反而实测 capture 会让部分环境改派 pointercancel，导致 pointerup 不触发。
	let isDown = false;
	let moved = false;
	let startX = 0;
	let startLeft = 0;
	scroller.addEventListener("pointerdown", (e) => {
		if (e.pointerType !== "mouse" || e.button !== 0) return;
		isDown = true;
		moved = false;
		startX = e.clientX;
		startLeft = scroller.scrollLeft;
	});
	const endDrag = () => {
		isDown = false;
		scroller.classList.remove("dragging");
	};
	window.addEventListener("pointermove", (e) => {
		if (!isDown) return;
		const dx = e.clientX - startX;
		if (!moved && Math.abs(dx) > 4) {
			moved = true;
			scroller.classList.add("dragging");
		}
		if (moved) scroller.scrollLeft = startLeft - dx;
	});
	window.addEventListener("pointerup", endDrag);
	window.addEventListener("pointercancel", endDrag);
	window.addEventListener("blur", endDrag);
	// 按住链接拖动几像素会触发浏览器原生链接拖拽，抢占手势——导航里不需要它
	scroller.addEventListener("dragstart", (e) => e.preventDefault());
	scroller.addEventListener(
		"click",
		(e) => {
			// 拖拽结束后的那一次 click 不应当触发链接跳转
			if (moved) {
				e.preventDefault();
				e.stopPropagation();
				moved = false;
			}
		},
		true,
	);

	// 悬停滚轮横滚：仅当内容溢出时拦截，否则放行给页面正常滚动
	scroller.addEventListener(
		"wheel",
		(e) => {
			if (scroller.scrollWidth <= scroller.clientWidth) return;
			const delta =
				Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
			if (!delta) return;
			e.preventDefault();
			scroller.scrollLeft += delta;
			updateFades();
		},
		{ passive: false },
	);
}
initNavLinksScroll();

/* 桌面端下拉子菜单：面板在启动时搬运到 sticky 的 #navbar-wrapper 下（脱离
   overflow 滚动容器，避免被裁剪 / 被滚动结构带走），absolute 相对导航条定位。
   触发：悬停 / 键盘聚焦导航项或面板本身；面板 DOM 不在触发元素内，
   跨「链接 → 面板」的空隙用 120ms 延迟关闭来衔接。 */
function initNavDropdowns() {
	const scroller = document.getElementById("nav-links-scroll");
	const host = document.getElementById("navbar-wrapper");
	const wraps = document.querySelectorAll<HTMLDivElement>(
		"#nav-links-scroll .nav-dropdown-wrap",
	);
	if (!scroller || !host || !wraps.length) return;
	// 导航栏跨页共享（swup 只换主内容，但会重跑本脚本）：
	// 面板首次已搬到 host 下，再跑一遍 wrap.querySelector 只会拿到 null。
	// 与 initNavLinksScroll 同一套幂等约定，监听器也只注册一次。
	if (scroller.dataset.dropdownInit === "1") return;
	scroller.dataset.dropdownInit = "1";
	let openWrap: HTMLElement | null = null;
	let closeTimer: ReturnType<typeof setTimeout> | undefined = undefined;
	// 面板被搬运到 host 下后不再是 wrap 的后代，必须持引用查找
	const panelOf = new Map<HTMLElement, HTMLElement>();

	const position = (wrap: HTMLElement) => {
		const panel = panelOf.get(wrap);
		const anchor = wrap.querySelector<HTMLElement>(":scope > a");
		if (!panel || !anchor) return;
		// 面板挂在 host 下：坐标一律换算成相对 host 的偏移。
		// host 是 sticky 元素且与锚点同帧测量，滚动状态不影响相对关系。
		const hr = host.getBoundingClientRect();
		const ar = anchor.getBoundingClientRect();
		panel.style.left = `${Math.round(ar.left + ar.width / 2 - hr.left)}px`;
		panel.style.top = `${Math.round(hr.height + 4)}px`;
	};
	const open = (wrap: HTMLElement) => {
		// 拖拽横滑链接时不弹面板，避免滑动过程闪面板
		if (scroller.classList.contains("dragging")) return;
		if (openWrap && openWrap !== wrap) close(openWrap);
		openWrap = wrap;
		position(wrap);
		wrap.classList.add("dropdown-open");
		panelOf.get(wrap)?.classList.add("dropdown-open");
	};
	const close = (wrap: HTMLElement) => {
		wrap.classList.remove("dropdown-open");
		panelOf.get(wrap)?.classList.remove("dropdown-open");
		if (openWrap === wrap) openWrap = null;
	};
	const scheduleClose = (wrap: HTMLElement) => {
		clearTimeout(closeTimer);
		closeTimer = setTimeout(() => close(wrap), 120);
	};

	wraps.forEach((wrap) => {
		// 面板由模板保证存在；不在闭包外判空，避免 TS 跨闭包收窄失败
		const panel = wrap.querySelector<HTMLElement>(".nav-dropdown-panel")!;
		// 搬出滚动容器，挂到 sticky 的导航条宿主下（幂等），并记录引用
		if (panel.parentElement !== host) host.appendChild(panel);
		panelOf.set(wrap, panel);
		wrap.addEventListener("mouseenter", () => open(wrap));
		wrap.addEventListener("mouseleave", () => scheduleClose(wrap));
		panel.addEventListener("mouseenter", () => clearTimeout(closeTimer));
		panel.addEventListener("mouseleave", () => scheduleClose(wrap));
		wrap.addEventListener("focusin", () => open(wrap));
		panel.addEventListener("focusin", () => open(wrap));
	});
	document.addEventListener("focusin", (e) => {
		const target = e.target as Node | null;
		wraps.forEach((wrap) => {
			const panel = panelOf.get(wrap);
			if (!wrap.contains(target) && !(panel && panel.contains(target))) {
				close(wrap);
			}
		});
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && openWrap) close(openWrap);
	});
	window.addEventListener("resize", () => {
		if (openWrap) position(openWrap);
	});
	window.addEventListener(
		"scroll",
		() => {
			if (openWrap) position(openWrap);
		},
		{ passive: true },
	);
}
initNavDropdowns();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
